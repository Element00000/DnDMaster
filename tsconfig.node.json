{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "target": "ES2022",
    "lib": ["ES2023"],
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "outDir": "node_modules/.cache/tsnode",
    "tsBuildInfoFile": "node_modules/.cache/tsnode/node.tsbuildinfo"
  },
  "include": ["vite.config.ts", "api/**/*.ts"]
}
