# Serverseitige Bildgenerierung (Key bleibt geheim, nur auf dem Server).
# Auf Vercel: unter Project Settings -> Environment Variables setzen.
# Lokal: diese Datei nach ".env" kopieren und ausfuellen (wird von .gitignore ignoriert).
#
# Es wird der erste vorhandene Provider genutzt (Gemini -> OpenAI -> Pollinations).
# Ohne jeden Key funktioniert Pollinations.ai automatisch (kostenlos, ohne Anmeldung).

# Google Gemini (kostenloses Kontingent) — https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.0-flash-preview-image-generation

# OpenAI (kostenpflichtig)
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1

# Pollinations.ai (kostenlos, kein Key) — nur Modell optional
# POLLINATIONS_MODEL=flux
